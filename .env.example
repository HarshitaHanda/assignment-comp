# Composio
COMPOSIO_API_KEY=ak_your_project_key_here

# Optional ambiguity resolver.
# Deterministic rules remain the primary classifier.
USE_LLM_FALLBACK=true
LLM_FALLBACK_ORDER=bazaar,groq,gemini

BAZAARLINK_API_KEY=
BAZAARLINK_MODEL=auto:free

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

RESEARCH_MAX_PAGES=8
RESEARCH_TIMEOUT_SECONDS=15
RULE_CONFIDENCE_THRESHOLD=0.72
