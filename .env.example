COMPOSIO_API_KEY=ak_your_project_key_here

# Optional ambiguity resolver. Rules remain the default classifier.
USE_LLM_FALLBACK=true
LLM_FALLBACK_ORDER=groq,gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

RESEARCH_MAX_PAGES=8
RESEARCH_TIMEOUT_SECONDS=15
RULE_CONFIDENCE_THRESHOLD=0.72
